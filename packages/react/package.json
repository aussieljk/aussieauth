{
  "name": "@aussieljk/auth",
  "version": "0.3.0",
  "description": "AussieAuth's drop-in React sign-in card and auth client.",
  "homepage": "https://aussieauth.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aussieljk/aussieauth.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./expo": {
      "types": "./dist/expo.d.ts",
      "import": "./dist/expo.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "import": "./dist/solana.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "bin": {
    "aussieauth": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun run build:js && bun run build:css",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./styles.src.css -o ./dist/styles.css",
    "dev": "bun run sync && tsup --watch",
    "lint": "tsc --noEmit",
    "sync": "bun run ../../scripts/sync-server-plugins.ts",
    "prebuild": "bun run sync",
    "release": "bun run build && bun publish --access public"
  },
  "dependencies": {
    "@aussieljk/frosted": "^0.0.1-2",
    "bs58": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/api-key": "1.6.23",
    "@better-auth/passkey": "1.6.23",
    "@convex-dev/better-auth": "^0.12.5",
    "@noble/curves": "^2.2.0",
    "@tailwindcss/cli": "^4.2.2",
    "@types/node": "^26",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-auth": "1.6.23",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@better-auth/api-key": "1.6.23",
    "@better-auth/expo": "1.6.23",
    "@better-auth/passkey": "1.6.23",
    "@convex-dev/better-auth": "^0.12.5",
    "better-auth": "1.6.23",
    "react": "^19.0.0",
    "expo-secure-store": "*",
    "expo-web-browser": "*",
    "expo-router": "*",
    "react-native": "*",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@better-auth/expo": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
