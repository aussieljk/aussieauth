# Loaded by vitest (mode "test") and takes priority over .env.local, which is
# where `convex dev` writes the real deployment URL.
#
# Without this the component tests point the auth client at the live deployment:
# `msw` is set to bypass unhandled requests, so every endpoint a fixture doesn't
# mock goes out over the network and shows up in `convex dev` as
# "Client disconnected" when the browser tears down mid-request.
#
# Empty makes every auth URL relative to the test server, which is what the
# `*/api/auth/...` handler patterns already assume — and what the comment in
# src/testing/handlers.ts always claimed was happening.
VITE_CONVEX_SITE_URL=
VITE_CONVEX_URL=
VITE_GOOGLE_CLIENT_ID=
