{
  "name": "aussieauth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "portless run vite",
    "dev:backend": "convex dev",
    "build": "tsc && vite build",
    "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:component": "vitest run --project=component",
    "preview": "vite preview",
    "format": "prettier --write .",
    "auth:schema": "bun run scripts/generate-auth-schema.ts",
    "cosmos": "cosmos",
    "cosmos:export": "cosmos-export"
  },
  "dependencies": {
    "@aussieljk/frosted": "^0.0.1-1",
    "@better-auth/api-key": "^1.6.23",
    "@better-auth/expo": "1.6.23",
    "@better-auth/passkey": "^1.6.23",
    "@convex-dev/better-auth": "^0.12.5",
    "@noble/curves": "^2.2.0",
    "better-auth": "~1.6.15",
    "bs58": "^6.0.0",
    "convex": "^1.42.3",
    "jose": "^6.2.4",
    "lucide-react": "^1.26.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jiti": "^2.7.0",
    "msw": "^2.15.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.3",
    "react-cosmos": "^7.3.0",
    "react-cosmos-plugin-vite": "^7.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
